---
import { u } from '../config';
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: { href: string; label: string }[];
}
const { eyebrow, title, lead, crumbs = [] } = Astro.props;
---
<section class="relative overflow-hidden border-b border-navy-100 bg-gradient-to-b from-sky-soft/70 to-white">
  <div class="grid-bg absolute inset-0 [mask-image:linear-gradient(to_bottom,black,transparent)]"></div>
  <div class="container-page relative py-14 sm:py-20">
    {crumbs.length > 0 && (
      <nav aria-label="Omrvinková navigácia" class="mb-5 text-sm text-navy-600">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={u('/')} class="hover:text-navy-900">Domov</a></li>
          {crumbs.map((c, i) => (
            <li class="flex items-center gap-2">
              <span aria-hidden="true">/</span>
              {i === crumbs.length - 1 ? <span aria-current="page" class="text-navy-900">{c.label}</span> : <a href={u(c.href)} class="hover:text-navy-900">{c.label}</a>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="max-w-3xl text-4xl font-extrabold sm:text-5xl">{title}</h1>
    {lead && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-navy-700">{lead}</p>}
    <slot />
  </div>
</section>
