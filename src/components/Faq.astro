---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---
<div class="divide-y divide-navy-100 rounded-2xl border border-navy-100 bg-white">
  {items.map((item) => (
    <details class="group px-6 py-5">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-bold text-navy-900 [&::-webkit-details-marker]:hidden">
        {item.q}
        <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-navy-50 text-navy-800 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
      </summary>
      <p class="mt-3 leading-relaxed text-navy-700">{item.a}</p>
    </details>
  ))}
</div>
