---
import { SITE, phoneHref, u } from '../config';
import Icon from './Icon.astro';
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Plánujete novú elektroinštaláciu alebo rekonštrukciu?',
  text = 'Ozvite sa, dohodneme si obhliadku a pripravím vám cenovú ponuku na mieru.',
} = Astro.props;
---
<section class="container-page mt-24">
  <div class="relative overflow-hidden rounded-3xl bg-navy-800 px-6 py-12 text-white sm:px-12 sm:py-14">
    <div class="absolute -right-10 -top-10 h-56 w-56 rounded-full bg-sky-brand/25 blur-2xl"></div>
    <div class="absolute -bottom-16 right-32 h-40 w-40 rounded-full bg-volt/20 blur-2xl"></div>
    <div class="relative flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-extrabold !text-white sm:text-4xl">{title}</h2>
        <p class="mt-3 text-lg text-navy-100">{text}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href={u('/kontakt/')} class="btn-primary">Nezáväzná ponuka <Icon name="arrow" class="h-5 w-5" /></a>
        {SITE.phone && (
          <a href={phoneHref(SITE.phone)} class="btn border border-white/30 text-white hover:bg-white/10">
            <Icon name="phone" class="h-5 w-5" /> {SITE.phone}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
