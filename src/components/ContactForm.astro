---
import { SITE, u } from '../config';
import { SERVICES } from '../data/services';
const inputCls =
  'mt-1.5 block w-full rounded-xl border border-navy-200 bg-white px-4 py-3 text-base text-navy-900 placeholder:text-navy-600/50 focus:border-sky-brand focus:outline-none focus:ring-3 focus:ring-sky-brand/20';
---
<form
  id="contact-form"
  class="card space-y-5 !p-6 sm:!p-8"
  data-key={SITE.web3formsKey}
  data-email={SITE.email}
  novalidate
>
  <input type="hidden" name="subject" value="Nový dopyt z webu KMK elmont" />
  <input type="hidden" name="from_name" value="Web KMK elmont" />
  <!-- ochrana proti spamu -->
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

  <div class="grid gap-5 sm:grid-cols-2">
    <label class="block text-sm font-semibold text-navy-900">
      Meno a priezvisko *
      <input name="name" required autocomplete="name" data-msg="Zadajte prosím vaše meno." class={inputCls} placeholder="Ján Novák" />
    </label>
    <label class="block text-sm font-semibold text-navy-900">
      Telefón *
      <input name="phone" type="tel" required autocomplete="tel" data-msg="Zadajte telefónne číslo, aby som sa vám mohol ozvať." class={inputCls} placeholder="+421 9xx xxx xxx" />
    </label>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <label class="block text-sm font-semibold text-navy-900">
      E-mail
      <input name="email" type="email" autocomplete="email" data-msg="Skontrolujte prosím formát e-mailu, napríklad jan@email.sk." class={inputCls} placeholder="vas@email.sk" />
    </label>
    <label class="block text-sm font-semibold text-navy-900">
      Obec / mesto
      <input name="location" autocomplete="address-level2" class={inputCls} placeholder={SITE.city} />
    </label>
  </div>

  <label class="block text-sm font-semibold text-navy-900">
    O akú prácu ide?
    <select name="service" class={inputCls}>
      {SERVICES.map((s) => <option>{s.title}</option>)}
      <option>Iné</option>
    </select>
  </label>

  <label class="block text-sm font-semibold text-navy-900">
    Správa *
    <textarea name="message" rows="5" required data-msg="Napíšte prosím, o akú prácu ide." class={inputCls} placeholder="Napr. rekonštrukcia elektroinštalácie v 3-izbovom byte, termín približne v marci…"></textarea>
  </label>

  <label class="flex items-start gap-3 text-sm text-navy-700">
    <input type="checkbox" name="consent" required data-msg="Bez súhlasu so spracovaním údajov vám nemôžem odpovedať." class="mt-0.5 h-5 w-5 shrink-0 rounded border-navy-200 accent-navy-800" />
    <span>Súhlasím so spracovaním osobných údajov za účelom vybavenia dopytu. <a href={u('/ochrana-osobnych-udajov/')} class="font-semibold text-navy-900 underline">Viac informácií</a></span>
  </label>

  <!-- hCaptcha (Web3Forms) – widget vykreslí skript nižšie, token sa posiela ako h-captcha-response -->
  <div class="h-captcha" data-captcha="true" data-lang="sk"></div>

  <button type="submit" class="btn-primary w-full sm:w-auto">Odoslať dopyt</button>
  <p id="form-status" class="hidden rounded-xl px-4 py-3 text-sm font-medium" role="status" aria-live="polite"></p>
</form>

<script src="https://web3forms.com/client/script.js" async defer is:inline></script>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  const show = (msg: string, ok: boolean) => {
    if (!status) return;
    status.textContent = msg;
    status.className = `rounded-xl px-4 py-3 text-sm font-medium ${ok ? 'bg-green-50 text-green-800' : 'bg-red-50 text-red-800'}`;
  };

  // Vlastné chybové hlásenia v slovenčine – prehliadač zobrazuje svoje vlastné
  // v jazyku prehliadača ("Please fill out this field"), preto ich nepoužívame.
  const errCls = 'field-error mt-1.5 block text-sm font-medium text-red-600';

  const clearError = (field: Element) => {
    const label = field.closest('label');
    label?.parentElement?.querySelectorAll(':scope > .field-error').forEach((n) => n.remove());
    label?.querySelectorAll('.field-error').forEach((n) => n.remove());
    field.classList.remove('!border-red-400');
  };

  const showError = (field: HTMLInputElement | HTMLTextAreaElement, msg: string) => {
    clearError(field);
    const span = document.createElement('span');
    span.className = errCls;
    span.textContent = msg;
    const label = field.closest('label');
    if (!label) return;
    if (field.type === 'checkbox') label.parentElement?.insertBefore(span, label.nextSibling);
    else label.appendChild(span);
    field.classList.add('!border-red-400');
  };

  const messageFor = (field: HTMLInputElement | HTMLTextAreaElement) => {
    const custom = field.dataset.msg;
    if (field.validity.valueMissing) return custom ?? 'Toto pole je povinné.';
    if (field.validity.typeMismatch) return custom ?? 'Skontrolujte prosím zadanú hodnotu.';
    return custom ?? 'Skontrolujte prosím zadanú hodnotu.';
  };

  const fields = Array.from(
    form?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[name]:not([type=hidden]), textarea[name]') ?? [],
  ).filter((f) => f.name !== 'botcheck');

  fields.forEach((f) => {
    f.addEventListener('input', () => f.checkValidity() && clearError(f));
    f.addEventListener('change', () => f.checkValidity() && clearError(f));
  });

  const validate = () => {
    let first: HTMLInputElement | HTMLTextAreaElement | null = null;
    fields.forEach((f) => {
      if (f.checkValidity()) {
        clearError(f);
      } else {
        showError(f, messageFor(f));
        if (!first) first = f;
      }
    });
    first?.focus();
    return !first;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validate()) {
      show('Skontrolujte prosím vyznačené polia.', false);
      return;
    }
    // hCaptcha – bez potvrdenia Web3Forms správu odmietne, tak to povieme skôr
    const captcha = form.querySelector('textarea[name="h-captcha-response"]') as HTMLTextAreaElement | null;
    if (captcha && !captcha.value) {
      show('Potvrďte prosím, že nie ste robot.', false);
      return;
    }

    const data = new FormData(form);
    const key = form.dataset.key;

    // Bez nastaveného kľúča otvoríme emailového klienta
    if (!key) {
      const body = [...data.entries()]
        .filter(([k]) => ['name', 'phone', 'email', 'location', 'service', 'message'].includes(k))
        .map(([k, v]) => `${k}: ${v}`)
        .join('\n');
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Dopyt z webu')}&body=${encodeURIComponent(body)}`;
      return;
    }

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Odosielam…';
    data.append('access_key', key);
    try {
      const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: data });
      const json = await res.json();
      if (json.success) {
        form.reset();
        show('Ďakujem, správa bola odoslaná. Ozvem sa vám čo najskôr.', true);
      } else {
        throw new Error(json.message);
      }
    } catch {
      show(`Správu sa nepodarilo odoslať. Skúste to znova alebo napíšte na ${form.dataset.email}.`, false);
    } finally {
      btn.disabled = false;
      btn.textContent = 'Odoslať dopyt';
    }
  });
</script>
