---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { abs, BUSINESS_ID, SITE, u } from '../config';

interface Props {
  /** Titulok stránky (bez názvu firmy – ten sa doplní automaticky) */
  title: string;
  /** Popis pre Google (ideálne 120–160 znakov) */
  description: string;
  /** Doplnkové štruktúrované dáta (JSON-LD) pre konkrétnu stránku */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  fullTitle?: boolean;
}

const { title, description, schema = [], noindex = false, fullTitle = false } = Astro.props;
const pageTitle = fullTitle ? title : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = abs('/og-image.jpg');

// Štruktúrované dáta o firme – Google z nich zobrazuje údaje vo vyhľadávaní a v mapách
const business = {
  '@context': 'https://schema.org',
  '@type': 'Electrician',
  '@id': BUSINESS_ID,
  name: SITE.legalName,
  alternateName: SITE.name,
  description: `${SITE.tagline}. Nové elektroinštalácie a rekonštrukcie elektroinštalácií v lokalite ${SITE.city} a okolie.`,
  url: abs('/'),
  logo: abs('/logo.png'),
  image: abs('/og-image.jpg'),
  email: SITE.email,
  ...(SITE.phone && { telephone: SITE.phone.replace(/\s+/g, '') }),
  founder: { '@type': 'Person', name: SITE.owner },
  taxID: SITE.ico,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.city,
    postalCode: SITE.postalCode,
    addressRegion: SITE.region,
    addressCountry: SITE.country,
  },
  areaServed: SITE.serviceArea.map((c) => ({ '@type': 'City', name: c })),
  openingHours: SITE.openingHoursSchema,
  priceRange: 'Podľa dohody',
  sameAs: [SITE.facebook, SITE.instagram, SITE.googleBusiness].filter(Boolean),
};
---
<!doctype html>
<html lang="sk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#1e3a5f" />

    <link rel="icon" type="image/png" href={u('/favicon.png')} />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <link rel="sitemap" href={u('/sitemap-index.xml')} />

    <!-- Open Graph (Facebook, WhatsApp, Messenger…) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sk_SK" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#obsah" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2">
      Preskočiť na obsah
    </a>
    <Header />
    <main id="obsah" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
