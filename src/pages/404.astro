---
import { u } from '../config';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout title="Stránka sa nenašla" description="Požadovaná stránka neexistuje." noindex>
  <section class="container-page flex flex-col items-center py-28 text-center">
    <span class="grid h-16 w-16 place-items-center rounded-2xl bg-volt-soft text-volt-dark"><Icon name="plug" class="h-8 w-8" /></span>
    <p class="mt-6 text-sm font-semibold uppercase tracking-wider text-sky-brand">Chyba 404</p>
    <h1 class="mt-2 text-4xl font-extrabold">Tu nám vypadol prúd</h1>
    <p class="mt-4 max-w-md text-lg text-navy-700">Stránka, ktorú hľadáte, neexistuje alebo bola presunutá.</p>
    <a href={u('/')} class="btn-primary mt-8">Späť na úvod</a>
  </section>
</Layout>
